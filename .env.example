# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud → YouTube Data API v3. Только сервер, в клиент не попадает.
# В кабинете Supabase для Google OAuth укажите redirect:
# http://localhost:3000/api/auth/callback
YOUTUBE_API_KEY=

# Схему таблиц выполните в SQL Editor: supabase/schema.sql
