# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Last.fm → API аккаунт (бесплатный ключ для чартов)
LASTFM_API_KEY=

# Google Cloud → YouTube Data API v3. Только сервер, в клиент не попадает.
YOUTUBE_API_KEY=

# OAuth redirect для Supabase Google-провайдера (указать в Google Cloud
# Authorized redirect URIs и в Supabase → Authentication → URL Configuration):
# https://<твой-домен>/api/auth/callback

# Таблицы: выполните supabase/schema.sql в SQL Editor Supabase
